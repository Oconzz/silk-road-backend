# AWS Configuration for NMJ Backend
# Copy this file to .env and fill in your actual credentials.
# These values will be loaded by Docker Compose and override appsettings.json.

# AWS Credentials
AwsSettings__AWS_ACCESS_KEY=your_access_key_here
AwsSettings__AWS_SECRET_KEY=your_secret_key_here

# S3 Configuration
AwsSettings__S3PrivateBucket=your-private-bucket-name
AwsSettings__S3Region=us-east-1
